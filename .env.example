# Copy to .env. Never commit the completed file or paste these values into chat.
# Neon connection string with pooling ON (hostname contains -pooler).
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Neon connection string with pooling OFF; used only by Prisma CLI/migrations.
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-HOST.REGION.aws.neon.tech/neondb?sslmode=require"
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3001"
# Optional Resend account + verified sender enables password recovery.
RESEND_API_KEY=""
AUTH_EMAIL_FROM=""
