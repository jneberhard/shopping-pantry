{
  "name": "pantry-and-table",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.0",
  "pnpm": { "onlyBuiltDependencies": ["@prisma/engines", "prisma", "sharp", "esbuild"] },
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "node scripts/prepare-public.mjs && next dev -p 3001",
    "build": "prisma generate && node scripts/prepare-public.mjs && next build",
    "start": "next start -p 3001",
    "postinstall": "prisma generate",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check": "node --check dist/app.js && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:check": "node --env-file=.env scripts/check-database.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "better-auth": "^1.4.0",
    "dotenv": "^17.2.0",
    "next": "^16.0.0",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prisma": "^7.0.0",
    "typescript": "^5.9.0"
  }
}
